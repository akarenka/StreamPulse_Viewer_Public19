rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/liveRooms/$(roomId)).data;
    }

    function isRoomOwner(roomId) {
      return signedIn() && roomData(roomId).ownerUid == request.auth.uid;
    }

    function isRoomAdmin(roomId) {
      return signedIn()
        && roomData(roomId).adminUids is list
        && request.auth.uid in roomData(roomId).adminUids;
    }

    function isRoomManager(roomId) {
      return isRoomOwner(roomId) || isRoomAdmin(roomId);
    }

    function validTestPurchase(points, usd) {
      return (points == 100 && usd == 2)
        || (points == 300 && usd == 6)
        || (points == 600 && usd == 8)
        || (points == 1000 && usd == 10)
        || (points == 10000 && usd == 20);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if ownsUser(uid) && request.resource.data.points == 300;
      allow update: if ownsUser(uid)
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && ((!('points' in resource.data) && request.resource.data.points == 300)
          || request.resource.data.points <= resource.data.points
          || (request.resource.data.testMode == true
            && (request.resource.data.points - resource.data.points) in [100, 300, 600, 1000, 10000]));

      match /following/{roomId} {
        allow read, create, update, delete: if ownsUser(uid);
      }

      match /testPurchases/{purchaseId} {
        allow read: if ownsUser(uid);
        allow create: if ownsUser(uid)
          && request.resource.data.testMode == true
          && request.resource.data.points is int
          && request.resource.data.usd is int
          && validTestPurchase(request.resource.data.points, request.resource.data.usd);
      }
    }

    // Google Play subscription status: the signed-in account may read only
    // its own entitlement. Only the trusted Admin SDK backend may write it.
    match /entitlements/{uid} {
      allow read: if ownsUser(uid);
      allow create, update, delete: if false;
    }

    // Firebase Google profile used by Edit Profile & Avatar.
    match /profiles/{uid} {
      allow read, create, update, delete: if ownsUser(uid);
    }

    // Private media lobby settings for the authenticated Google account.
    match /userMediaSettings/{uid} {
      allow read, create, update, delete: if ownsUser(uid);

      match /personalMeta/{mediaId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid)
          && request.resource.data.mediaId == mediaId
          && request.resource.data.title is string
          && request.resource.data.creator is string
          && request.resource.data.category is string
          && request.resource.data.creatorAvatar is string;
        allow delete: if ownsUser(uid);
      }

      match /creatorGroups/{groupId} {
        allow read: if ownsUser(uid);
        allow create, update: if ownsUser(uid)
          && request.resource.data.creator is string
          && request.resource.data.creatorKey is string
          && request.resource.data.cover is string
          && request.resource.data.cover.size() < 900000;
        allow delete: if ownsUser(uid);
      }

      match /ui/{settingId} {
        allow read, create, update, delete: if ownsUser(uid);
      }
    }

    match /liveRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() <= 2;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (!('adminUids' in request.resource.data)
          || (request.resource.data.adminUids is list
            && request.resource.data.adminUids.size() <= 2))
        && ((resource.data.ownerUid == request.auth.uid)
          || (resource.data.adminUids is list
            && request.auth.uid in resource.data.adminUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['botEnabled', 'botName', 'botMessage', 'updatedAt'])));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /followers/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsUser(uid);
      }

      match /subscribers/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if ownsUser(uid);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/liveRooms/$(roomId)/bans/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/liveRooms/$(roomId)/mutes/$(request.auth.uid));
        allow update, delete: if isRoomManager(roomId);
      }

      match /gifts/{giftId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['points', 'subscribe']
          && request.resource.data.points is int
          && request.resource.data.points > 0
          && request.resource.data.points <= 10000;
        allow update: if false;
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/liveRooms/$(roomId)).data.ownerUid == request.auth.uid;
      }

      match /rankResets/{resetId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/liveRooms/$(roomId)).data.ownerUid == request.auth.uid;
        allow create: if signedIn()
          && get(/databases/$(database)/documents/liveRooms/$(roomId)).data.ownerUid == request.auth.uid
          && request.resource.data.resetByUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /bans/{uid} {
        allow read: if ownsUser(uid) || isRoomManager(roomId);
        allow create, update, delete: if isRoomManager(roomId)
          && uid != roomData(roomId).ownerUid
          && (!(roomData(roomId).adminUids is list) || !(uid in roomData(roomId).adminUids));
      }

      match /mutes/{uid} {
        allow read: if ownsUser(uid) || isRoomManager(roomId);
        allow create, update, delete: if isRoomManager(roomId)
          && uid != roomData(roomId).ownerUid
          && (!(roomData(roomId).adminUids is list) || !(uid in roomData(roomId).adminUids));
      }
    }
  }
}
